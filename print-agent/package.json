{
  "name": "print-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Local print agent for POS: exposes an HTTP API that formats ESC/POS receipts and sends them to a thermal receipt printer / cash drawer over TCP.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
